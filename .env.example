# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site: which tenant to render at `/` locally (dev/apex convenience).
DEV_BUSINESS_SLUG=ronies

# Multi-tenant subdomain routing. When set (e.g. "example.com"), the middleware
# maps `<slug>.example.com` → the internal `/s/<slug>` route. Leave BLANK for
# local dev — tenants are then reachable directly at `/s/<slug>`.
NEXT_PUBLIC_ROOT_DOMAIN=

# Messenger webhook (server-only). Both are required before /api/messenger/
# webhook will answer: without the verify token Meta's callback check gets a
# 503, and without the app secret every delivery is refused.
#   META_WEBHOOK_VERIFY_TOKEN — you invent it; a long random string. This is the
#     value typed into Messenger → Settings → Webhooks, nothing else.
#   META_APP_SECRET — Meta app → Settings → Basic (reveal). Signs the
#     X-Hub-Signature-256 header on every delivery.
# The PAGE ACCESS TOKEN is deliberately absent: it is per-Page, one per client,
# and belongs encrypted in the database. See docs/messenger-ai.md §1.3.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# Encrypts Page Access Tokens at rest (AES-256-GCM). At least 32 characters —
# shorter is refused rather than warned about. Needed only once Pages are
# connected; the webhook stores messages without it.
# Rotating this makes every stored Page token undecryptable: re-connect each Page.
MESSENGER_TOKEN_ENCRYPTION_KEY=
# Replies. OPT-IN, like AI SMS: leave MESSENGER_AI_PROVIDER blank and the bot
# stores messages and never answers — the thread is left for a human, the safe
# default for a Page nobody has configured to reply.
#   MESSENGER_AI_PROVIDER — blank = silent | openai | anthropic
#   Keys are per-feature first, shared second (MESSENGER_OPENAI_API_KEY before
#   OPENAI_API_KEY), so the bot can be billed or revoked on its own while a
#   single-key setup still just works.
#   MESSENGER_MODEL  — optional override. Defaults: claude-opus-5 (anthropic),
#     OPENAI_MODEL or gpt-4o-mini (openai).
#   MESSENGER_EFFORT — anthropic only: low | medium | high. Defaults to low —
#     answering from a fixed fact sheet is latency-shaped, not reasoning-shaped.
#   META_GRAPH_VERSION — pinned, e.g. v23.0. Never "latest".
MESSENGER_AI_PROVIDER=
MESSENGER_OPENAI_API_KEY=
MESSENGER_ANTHROPIC_API_KEY=
META_GRAPH_VERSION=v23.0
MESSENGER_MODEL=
MESSENGER_EFFORT=

# Custom-domain provisioning (server-only). Registers each tenant hostname with
# the Vercel project so it routes here and gets a certificate. Without these,
# domains can still be recorded but never provisioned/verified.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=                 # only if the project lives under a team
# This project's DNS target, e.g. 33165ec7eaa7cde9.vercel-dns-017.com — copy it
# from "View DNS configuration" on any domain in the Vercel dashboard. It names
# the PROJECT, so one value covers every tenant hostname. Set it and /admin/
# domains hands owners the CNAME Vercel currently recommends (apex included);
# leave it blank and they get the legacy A record, which still works but makes
# Vercel show "DNS Change Recommended" on every domain.
VERCEL_DNS_TARGET=
# Global Config store id, needed to WRITE the routing table. Normally leave this
# BLANK: it is derived from the GLOBAL_CONFIG connection string below. Set it
# only if that derivation fails for your store.
GLOBAL_CONFIG_ID=

# Global Config connection string (Vercel renamed Edge Config → Global Config in
# July 2026). Holds the hostname → tenant routing table so the edge middleware
# can resolve CUSTOM DOMAINS with no DB round-trip.
#
# Connecting a store to the project injects ONE of these automatically: newly
# connected stores set GLOBAL_CONFIG, stores connected before the rename still
# set EDGE_CONFIG. The app reads either, so set whichever Vercel gave you.
#
# Leave BLANK locally — routing then falls back to the platform subdomain and
# DEV_BUSINESS_SLUG (custom domains simply aren't exercised in local dev).
GLOBAL_CONFIG=
EDGE_CONFIG=                    # legacy name, still honoured

# Apex/base site URL, used for canonical URLs, robots.txt, and sitemap.xml.
# e.g. https://example.com. When ROOT_DOMAIN is set, each tenant's canonical is
# https://<slug>.<root>; otherwise it's ${SITE_URL}/s/<slug>.
NEXT_PUBLIC_SITE_URL=

# Supabase (Settings → API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Review automation processor (server-only). The service_role key BYPASSES RLS
# and must never be exposed to the browser. CRON_SECRET guards the cron route
# (/api/jobs/review-automation): send Authorization: Bearer <CRON_SECRET>.
# REQUIRED in production: the schedule in vercel.json invokes that route every
# 15 min, and Vercel Cron auto-attaches this secret as the Bearer token — so if
# CRON_SECRET is unset the processor never runs (and, unset, the route 401s).
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Signing key for platform-staff "act as" (impersonation) cookies. Optional —
# falls back to SUPABASE_SERVICE_ROLE_KEY, which impersonation requires anyway.
# Rotating either key immediately invalidates any live act-as session.
IMPERSONATION_SECRET=

# Observability (optional). When set, structured error logs are also POSTed to
# this URL (Slack incoming webhook, Logtail/log-drain, etc.). Unset = console only.
ERROR_WEBHOOK_URL=

# ── SMS ──────────────────────────────────────────────────────────────────────
# Which carrier sends the texts (booking alerts, customer confirmations, review
# automation). Blank auto-detects from whichever credentials below are filled in,
# preferring Twilio — so an existing Twilio deployment needs no change.
#
# With nothing configured, SMS falls back to a no-op stub that logs and reports
# success: bookings still save, no text leaves the server. Naming a provider you
# haven't given credentials to logs an error and stubs — it never fails silently.
#
#   twilio    numeric sender, worldwide
#   philsms   Philippines, alphanumeric sender ID
#   semaphore Philippines, alphanumeric sender ID
SMS_PROVIDER=                   # twilio | philsms | semaphore (blank = auto-detect)

# ── Sender ID is NOT configured here ─────────────────────────────────────────
# The alphanumeric label a recipient sees lives on each business row
# (businesses.sms_sender_id, migration 0028) and is edited per client at
# /platform/businesses/<id>. There is deliberately no environment variable and
# no fallback to the business name:
#   - one env value cannot be correct for many tenants
#   - the business name is client-editable, and sender IDs must be REGISTERED
#     with the carrier, so a rename could silently start getting texts rejected
# With no sender ID set for a business: Semaphore uses your account's registered
# default Sender Name, PhilSMS refuses to send, Twilio ignores it entirely.

# PhilSMS (server-only). The token is the only setting.
PHILSMS_API_TOKEN=              # e.g. 1234|xxxxxxxx — treat as a password

# Semaphore (server-only, Philippines). The API key is the only setting.
# Their endpoint is rate-limited to 120 calls/minute, and a message beginning
# with the word "TEST" is silently discarded by them — the sender refuses to
# send those rather than reporting a success that never arrives.
SEMAPHORE_API_KEY=

# Twilio (server-only). Provide a Messaging Service SID (preferred) OR a single
# From number in E.164. Twilio has no alphanumeric sender field, so the business
# name reaches the recipient in the message body rather than the From.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=   # preferred (sender pool, opt-out, retries)
TWILIO_FROM_NUMBER=             # alternative, e.g. +15551234567
TWILIO_STATUS_CALLBACK_URL=     # optional, for delivery receipts webhook
# Exact public URL configured as the Messaging Service inbound webhook. Set this
# if the deployment is behind a proxy so Twilio signature validation matches.
TWILIO_WEBHOOK_URL=             # e.g. https://app.example.com/api/sms/inbound

# ── Marketing enquiries ──────────────────────────────────────────────────────
# Where the booking and contact forms on the platform's OWN landing page send
# their alerts. These are for Aliamz Digital, not for any tenant.
#
# Every enquiry is written to the `leads` table first (migration 0029), so
# leaving these blank loses nothing — it only means no one is told. The email
# carries the full detail; the SMS is a one-segment nudge to go and read it.
#
# Two inboxes, because the forms want different attention: a consultation is a
# slot someone is waiting on, a general enquiry can sit in the main inbox.
# PLATFORM_BOOKING_EMAIL falls back to PLATFORM_ALERT_EMAIL when unset, so a
# booking never goes nowhere. One SMS number covers both.
PLATFORM_ALERT_EMAIL=           # general enquiries, e.g. hello@aliamz.com
PLATFORM_BOOKING_EMAIL=         # consultations,     e.g. bookings@aliamz.com
PLATFORM_ALERT_PHONE=           # e.g. +639171234567
# Sender ID for that alert only. Tenant texts take theirs from the business row
# (/platform/businesses/<id>); this alert belongs to no business, so it has
# nowhere else to read one. Optional: Semaphore falls back to your account's
# registered default, PhilSMS has none and will decline without it.
PLATFORM_SMS_SENDER_ID=

# Default calling code (digits) used to normalize national phone numbers to
# E.164 on save, e.g. 63 (Philippines), 1 (US/CA). Numbers already in +E.164 or
# 00-international form don't need it.
SMS_DEFAULT_COUNTRY_CODE=

# Transactional email — Resend (server-only). Currently used to tell an owner a
# customer booked through their website (/api/bookings). BOTH values are needed:
# with either missing, email falls back to a no-op stub that logs and reports
# success, exactly like the Twilio stub above — bookings still save and the SMS
# still sends, no mail leaves the server.
# EMAIL_FROM must be on a domain verified in Resend, or every send is rejected.
#
# Only the ADDRESS in EMAIL_FROM is used for tenant mail — the display name is
# replaced per send with that tenant's business name, so the owner of Ronie's
# sees "Ronie's Barber" and not the platform or another client. Don't put a
# client's name here; every tenant shares this one value.
RESEND_API_KEY=
EMAIL_FROM=                     # e.g. "Aliamz Digital <bookings@example.com>"

# AI SMS generation (server-only). OPT-IN: leave AI_SMS_PROVIDER blank and the
# built-in template writer is used — no AI call, whatever keys exist below.
# A key alone never switches this on; SMS costs money per message and goes to
# customers under the business's own sender ID, so it takes a deliberate choice.
AI_SMS_PROVIDER=            # blank or "template" = templates | openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=               # optional, default gpt-4o-mini
ANTHROPIC_API_KEY=          # shared; also the Messenger bot's fallback key
ANTHROPIC_MODEL=            # optional, default claude-opus-4-8 (AI SMS only)
