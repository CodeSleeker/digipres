# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site: which tenant to render at `/` locally (dev/apex convenience).
DEV_BUSINESS_SLUG=ronies

# Multi-tenant subdomain routing. When set (e.g. "example.com"), the middleware
# maps `<slug>.example.com` → the internal `/s/<slug>` route. Leave BLANK for
# local dev — tenants are then reachable directly at `/s/<slug>`.
NEXT_PUBLIC_ROOT_DOMAIN=

# Custom-domain provisioning (server-only). Registers each tenant hostname with
# the Vercel project so it routes here and gets a certificate. Without these,
# domains can still be recorded but never provisioned/verified.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=                 # only if the project lives under a team
# Global Config store id, needed to WRITE the routing table. Normally leave this
# BLANK: it is derived from the GLOBAL_CONFIG connection string below. Set it
# only if that derivation fails for your store.
GLOBAL_CONFIG_ID=

# Global Config connection string (Vercel renamed Edge Config → Global Config in
# July 2026). Holds the hostname → tenant routing table so the edge middleware
# can resolve CUSTOM DOMAINS with no DB round-trip.
#
# Connecting a store to the project injects ONE of these automatically: newly
# connected stores set GLOBAL_CONFIG, stores connected before the rename still
# set EDGE_CONFIG. The app reads either, so set whichever Vercel gave you.
#
# Leave BLANK locally — routing then falls back to the platform subdomain and
# DEV_BUSINESS_SLUG (custom domains simply aren't exercised in local dev).
GLOBAL_CONFIG=
EDGE_CONFIG=                    # legacy name, still honoured

# Apex/base site URL, used for canonical URLs, robots.txt, and sitemap.xml.
# e.g. https://example.com. When ROOT_DOMAIN is set, each tenant's canonical is
# https://<slug>.<root>; otherwise it's ${SITE_URL}/s/<slug>.
NEXT_PUBLIC_SITE_URL=

# Supabase (Settings → API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Review automation processor (server-only). The service_role key BYPASSES RLS
# and must never be exposed to the browser. CRON_SECRET guards the cron route
# (/api/jobs/review-automation): send Authorization: Bearer <CRON_SECRET>.
# REQUIRED in production: the schedule in vercel.json invokes that route every
# 15 min, and Vercel Cron auto-attaches this secret as the Bearer token — so if
# CRON_SECRET is unset the processor never runs (and, unset, the route 401s).
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Signing key for platform-staff "act as" (impersonation) cookies. Optional —
# falls back to SUPABASE_SERVICE_ROLE_KEY, which impersonation requires anyway.
# Rotating either key immediately invalidates any live act-as session.
IMPERSONATION_SECRET=

# Observability (optional). When set, structured error logs are also POSTed to
# this URL (Slack incoming webhook, Logtail/log-drain, etc.). Unset = console only.
ERROR_WEBHOOK_URL=

# ── SMS ──────────────────────────────────────────────────────────────────────
# Which carrier sends the texts (booking alerts, customer confirmations, review
# automation). Blank auto-detects from whichever credentials below are filled in,
# preferring Twilio — so an existing Twilio deployment needs no change.
#
# With nothing configured, SMS falls back to a no-op stub that logs and reports
# success: bookings still save, no text leaves the server. Naming a provider you
# haven't given credentials to logs an error and stubs — it never fails silently.
#
#   twilio    numeric sender, worldwide
#   philsms   Philippines, alphanumeric sender ID (see PHILSMS_* below)
#   semaphore NOT IMPLEMENTED — under evaluation. Setting it stubs every send.
SMS_PROVIDER=                   # twilio | philsms (blank = auto-detect)

# PhilSMS (server-only). The token is all that's required.
#
# PHILSMS_SENDER_ID is the label the recipient sees instead of a number, and it
# behaves as a switch:
#   set    every tenant sends under this one fixed ID (use while only one is
#          approved with PhilSMS, e.g. PhilSMS)
#   blank  DYNAMIC — each text is sent under its own business name, normalized
#          to the 11-character alphanumeric limit ("Ronie's Barber" → "Ronies")
#
# Before going dynamic, check that PhilSMS will accept per-business sender IDs on
# your account. Sender IDs normally need registering, and an unregistered one is
# rejected or silently replaced — which looks like the platform losing texts.
PHILSMS_API_TOKEN=              # e.g. 1234|xxxxxxxx — treat as a password
PHILSMS_SENDER_ID=              # blank = use each client's business name

# Twilio (server-only). Provide a Messaging Service SID (preferred) OR a single
# From number in E.164. Twilio has no alphanumeric sender field, so the business
# name reaches the recipient in the message body rather than the From.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=   # preferred (sender pool, opt-out, retries)
TWILIO_FROM_NUMBER=             # alternative, e.g. +15551234567
TWILIO_STATUS_CALLBACK_URL=     # optional, for delivery receipts webhook
# Exact public URL configured as the Messaging Service inbound webhook. Set this
# if the deployment is behind a proxy so Twilio signature validation matches.
TWILIO_WEBHOOK_URL=             # e.g. https://app.example.com/api/sms/inbound

# Default calling code (digits) used to normalize national phone numbers to
# E.164 on save, e.g. 63 (Philippines), 1 (US/CA). Numbers already in +E.164 or
# 00-international form don't need it.
SMS_DEFAULT_COUNTRY_CODE=

# Transactional email — Resend (server-only). Currently used to tell an owner a
# customer booked through their website (/api/bookings). BOTH values are needed:
# with either missing, email falls back to a no-op stub that logs and reports
# success, exactly like the Twilio stub above — bookings still save and the SMS
# still sends, no mail leaves the server.
# EMAIL_FROM must be on a domain verified in Resend, or every send is rejected.
#
# Only the ADDRESS in EMAIL_FROM is used for tenant mail — the display name is
# replaced per send with that tenant's business name, so the owner of Ronie's
# sees "Ronie's Barber" and not the platform or another client. Don't put a
# client's name here; every tenant shares this one value.
RESEND_API_KEY=
EMAIL_FROM=                     # e.g. "Aliamz Digital <bookings@example.com>"

# AI SMS generation (server-only). Pick the default provider and add its key.
# If the chosen provider has no key (or none is set), the built-in template
# generator is used instead — no AI call, no key required.
AI_SMS_PROVIDER=            # openai | anthropic (blank = auto-detect from keys below)
OPENAI_API_KEY=
OPENAI_MODEL=               # optional, default gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # optional, default claude-opus-4-8
